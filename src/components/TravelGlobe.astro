---
import { localize } from "@/i18n/site";
import { places } from "@/data/personal";
import { getAssetPath } from "@/utils/withBase";
import "@/styles/globe.css";
const s = localize(Astro.currentLocale);
---

<section
  id="footprints"
  class="travel-section"
  aria-labelledby="footprints-title"
  data-globe
  data-world-url={getAssetPath("maps/world.json")}
  data-places={JSON.stringify(
    places.map(({ coordinates }) => ({
      coordinates,
    }))
  )}
>
  <h2 id="footprints-title" class="footprints-heading">{s("足迹")}</h2>
  <div class="globe-stage">
    <canvas
      class="travel-globe"
      tabindex="0"
      role="img"
      aria-label={s(
        "足迹地球仪。拖动或使用方向键旋转，加减键缩放，点击标记查看地点。"
      )}></canvas>
    <div class="globe-markers">
      {
        places.map((place, index) => (
          <button
            type="button"
            class:list={["globe-marker", { "is-residence": place.residence }]}
            data-globe-marker={index}
            aria-label={s(place.name)}
            aria-pressed="false"
            hidden
          >
            <span class="globe-marker-dot" aria-hidden="true" />
            <span class="globe-marker-label" aria-hidden="true">
              {s(place.name)}
            </span>
          </button>
        ))
      }
    </div>
    <p class="globe-loading" role="status">{s("地球正在展开…")}</p>
  </div>
</section>
<script>
  import { initGlobes } from "@/scripts/globe";
  initGlobes();
  document.addEventListener("astro:page-load", initGlobes);
</script>
