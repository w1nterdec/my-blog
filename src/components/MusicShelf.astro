---
import { music } from "@/data/personal";
import { localize } from "@/i18n/site";
import { getAssetPath } from "@/utils/withBase";

const s = localize(Astro.currentLocale);

const isJustin = (artist: string) => /justin\s+bieber/i.test(artist);
const records = [...music].sort(
  (a, b) => Number(isJustin(b.artist)) - Number(isJustin(a.artist))
);
const readyRecords = records.filter(item => item.title || item.cover);
const covers = readyRecords.length ? readyRecords : records.slice(0, 4);
const external = (value?: string) => {
  try {
    const url = new URL(value ?? "");
    return url.protocol === "https:" ? url.href : undefined;
  } catch {
    return undefined;
  }
};
---

<section class="music-shelf reveal" aria-labelledby="listening-title">
  <div class="section-heading">
    <div>
      <span class="eyebrow">03 / SOUNDS & SILENCES</span><h2
        id="listening-title"
      >
        聆 <span class="heading-note">{s("音乐")}</span>
      </h2>
    </div>
  </div>
  <p class="module-intro">{s("把喜欢的声音，留在身边。")}</p>
  <div
    class="music-grid music-stack"
    data-music-stack
    style={`--record-count:${Math.min(covers.length, 4)}`}
  >
    {
      records.map((item, index) => (
        <article
          class="music-card"
          data-record={index}
          data-active={index === 0 ? "true" : "false"}
        >
          {covers.includes(item) && (
            <button
              type="button"
              class:list={["record-cover", `record-tone-${index % 4}`]}
              style={`--record-index:${covers.indexOf(item)};--record-depth:${covers.length - covers.indexOf(item)}`}
              data-record-cover
              hidden={covers.indexOf(item) >= 4}
              aria-label={`${item.artist}${item.title ? ` · ${item.title}` : ""}`}
              aria-pressed={index === 0}
            >
              {item.cover ? (
                <img
                  src={getAssetPath(item.cover)}
                  alt={item.title ?? item.artist}
                  width="360"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="record-placeholder" aria-hidden="true">
                  <span class="record-disc">
                    <i />
                  </span>
                  <span class="record-initial">{item.artist.slice(0, 1)}</span>
                </div>
              )}
              {!item.cover && (
                <span class="record-cover-label">
                  {item.title ?? item.artist}
                </span>
              )}
            </button>
          )}
          <div class="record-info">
            <p class="eyebrow">
              {s(isJustin(item.artist) ? "偏爱" : "其他收藏")}
            </p>
            <h3>{item.title ?? item.artist}</h3>
            {item.title && <p>{item.artist}</p>}
            {item.title && <p class="record-kind">{s(item.kind)}</p>}
            {item.thought && (
              <p class="record-thought" lang="zh-CN">
                {item.thought}
              </p>
            )}
            <div class="music-links">
              {external(item.spotify) && (
                <a
                  href={external(item.spotify)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Spotify ↗
                </a>
              )}
              {external(item.qq) && (
                <a
                  href={external(item.qq)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  QQ Music ↗
                </a>
              )}
            </div>
            <section
              class:list={["lyric-card", `lyric-tone-${index % 4}`]}
              data-lyric-card
              aria-label={s("歌词摘句")}
            >
              <div class="lyric-heading">
                <span>{s("留下的一句")}</span>
                <button
                  type="button"
                  data-lyric-expand
                  aria-expanded="false"
                  aria-label={s("放大歌词卡片")}
                >
                  ↗
                </button>
              </div>
              {item.lyricSong && <p class="lyric-song">{item.lyricSong}</p>}
              {item.lyrics?.length ? (
                <div
                  class="lyric-lines"
                  data-lyric-lines
                  role="group"
                  aria-label={s("点击一句，慢慢读")}
                >
                  {item.lyrics.map((line, lineIndex) => (
                    <button
                      type="button"
                      data-lyric-line
                      aria-pressed={lineIndex === 0}
                    >
                      {line}
                    </button>
                  ))}
                </div>
              ) : (
                <div class="lyric-empty">
                  <span aria-hidden="true">“</span>
                  <p>{s("那句舍不得忘的歌词，留给你来写。")}</p>
                  <span class="lyric-empty-line" aria-hidden="true" />
                  <span class="lyric-empty-line" aria-hidden="true" />
                </div>
              )}
              <p class="lyric-footnote">
                {s(
                  item.lyrics?.length
                    ? "歌词摘句 · 点击高亮 / 滚动阅读"
                    : "歌词摘句 · 待填写"
                )}
              </p>
            </section>
          </div>
        </article>
      ))
    }
    <div class="record-selectors" role="group" aria-label={s("挑一张唱片")}>
      {
        records.map((item, index) => (
          <button
            type="button"
            data-record-select={index}
            aria-pressed={index === 0}
          >
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            {item.title ??
              (isJustin(item.artist) ? "Justin" : item.artist.split(" · ")[0])}
          </button>
        ))
      }
    </div>
  </div>
  {
    !music.some(item => item.cover || item.thought) && (
      <p class="module-note">{s("封面与听歌感想，慢慢补上。")}</p>
    )
  }
</section>
<script>
  import "@/scripts/music-stack";
</script>
