---
import { music } from "@/data/personal";
import { localize } from "@/i18n/site";
import { getAssetPath } from "@/utils/withBase";
import { getRelativeLocaleUrl } from "astro:i18n";
const s = localize(Astro.currentLocale);
const locale = Astro.currentLocale ?? "zh-CN";
const isJustin = (artist: string) => /justin\s+bieber/i.test(artist);
const records = [...music].sort(
  (a, b) => Number(isJustin(b.artist)) - Number(isJustin(a.artist))
);
const external = (value?: string) => {
  try {
    const url = new URL(value ?? "");
    return url.protocol === "https:" ? url.href : undefined;
  } catch {
    return undefined;
  }
};
---

<section class="music-shelf reveal" aria-labelledby="listening-title">
  <div class="section-heading">
    <div>
      <span class="eyebrow">03 / SOUNDS & SILENCES</span><h2
        id="listening-title"
      >
        聆 <span class="heading-note">{s("音乐")}</span>
      </h2>
    </div>
    <span class="music-mouse-wrap">
      <button
        class="little-mouse"
        type="button"
        data-mouse
        aria-label={s("轻轻碰一下鼠鼠")}
        aria-expanded="false"
        aria-controls="mouse-note"
      >
        <svg viewBox="0 0 80 60" aria-hidden="true"
          ><path
            class="mouse-tail"
            d="M45 42c18 6 27-3 22-10"
            fill="none"
            stroke="#a88d7c"
            stroke-width="3"
            stroke-linecap="round"></path><ellipse
            cx="36"
            cy="39"
            rx="20"
            ry="14"
            fill="#b9aaa0"></ellipse><circle
            cx="25"
            cy="20"
            r="12"
            fill="#b9aaa0"></circle><circle cx="25" cy="20" r="7" fill="#e2c6ba"
          ></circle><path
            d="M34 27q-14-4-22 13q-4 9 12 11h18q12-12-8-24"
            fill="#c8bcb3"></path><circle cx="22" cy="37" r="3" fill="#303830"
          ></circle><circle cx="21" cy="36" r="1" fill="white"></circle><circle
            cx="11"
            cy="44"
            r="2.5"
            fill="#b67d77"></circle><path
            d="M18 45l-9 5m10-7-11-1"
            stroke="#847369"
            stroke-width="1"
            stroke-linecap="round"></path></svg
        >
      </button>
      <span
        class="mouse-note"
        id="mouse-note"
        data-mouse-note
        hidden
        role="status"
        ><span data-mouse-message>{s("鼠鼠把一粒小种子留给了你。")}</span><a
          href={getRelativeLocaleUrl(locale, "island")}
          data-mouse-island
          hidden>{s("去孤岛坐坐 ↗")}</a
        ></span
      >
    </span>
  </div>
  <p class="module-intro">{s("把喜欢的声音，留在身边。")}</p>
  <div class="music-grid music-stack" data-music-stack>
    {
      records.map((item, index) => (
        <article
          class="music-card"
          data-record={index}
          data-active={index === 0 ? "true" : "false"}
        >
          <button
            type="button"
            class:list={["record-cover", `record-tone-${index % 4}`]}
            style={`--record-index:${records.length > 1 ? (index * 3) / (records.length - 1) : 0};--record-depth:${records.length - index}`}
            data-record-cover
            aria-label={`${item.artist}${item.title ? ` · ${item.title}` : ""}`}
            aria-pressed={index === 0}
          >
            {item.cover ? (
              <img
                src={getAssetPath(item.cover)}
                alt={item.title ?? item.artist}
                width="360"
                height="360"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="record-placeholder" aria-hidden="true">
                <span class="record-disc">
                  <i />
                </span>
                <span class="record-initial">{item.artist.slice(0, 1)}</span>
              </div>
            )}
            {!item.cover && (
              <span class="record-cover-label">
                {item.title ?? item.artist}
              </span>
            )}
          </button>
          <div class="record-info">
            <p class="eyebrow">
              {s(isJustin(item.artist) ? "偏爱" : "其他收藏")}
            </p>
            <h3>{item.title ?? item.artist}</h3>
            {item.title && <p>{item.artist}</p>}
            {item.title && <p class="record-kind">{s(item.kind)}</p>}
            {item.thought && (
              <p class="record-thought" lang="zh-CN">
                {item.thought}
              </p>
            )}
            <div class="music-links">
              {external(item.spotify) && (
                <a
                  href={external(item.spotify)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Spotify ↗
                </a>
              )}
              {external(item.qq) && (
                <a
                  href={external(item.qq)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  QQ Music ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
    <div class="record-selectors" role="group" aria-label={s("挑一张唱片")}>
      {
        records.map((item, index) => (
          <button
            type="button"
            data-record-select={index}
            aria-pressed={index === 0}
          >
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            {item.title ??
              (isJustin(item.artist) ? "Justin" : item.artist.split(" · ")[0])}
          </button>
        ))
      }
    </div>
  </div>
  {
    !music.some(item => item.cover || item.thought) && (
      <p class="module-note">{s("封面与听歌感想，慢慢补上。")}</p>
    )
  }
</section>
<script>
  import "@/scripts/mouse";
  import "@/scripts/music-stack";
</script>
