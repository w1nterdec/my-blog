---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import { localize } from "@/i18n/site";
import config from "@/config";
import { getRunningDays } from "@/utils/getRunningDays";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const s = localize(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;
const runningDays = config.site.startedAt
  ? getRunningDays(config.site.startedAt, new Date(), config.site.timezone)
  : null;
---

<footer
  class:list={[
    "wide-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="footer-row">
    <div class="footer-copy">
      {
        runningDays !== null && (
          <p
            class="site-uptime"
            data-site-uptime
            data-started-at={config.site.startedAt}
            data-timezone={config.site.timezone}
            title={`${s("运行起始日期")}：${config.site.startedAt}`}
            data-pagefind-ignore
          >
            {s("已运行")}{" "}
            <span data-running-days>{runningDays.toLocaleString(locale)}</span>{" "}
            {s("天")}
          </p>
        )
      }
      <p>
        {`© ${new Date().getFullYear()} ${config.site.author}`}
        <span class="footer-rights">{t.footer.allRightsReserved}</span>
      </p>
    </div>
    <Socials />
  </div>
  <p class="site-request-count" data-request-count hidden data-pagefind-ignore>
    {s("页面请求记录")} · <span data-request-total></span>
    <span class="sr-only">{s("包括机器人访问，不代表独立访客")}</span>
  </p>
</footer>
<script>
  import "@/scripts/stats";
  import "@/scripts/uptime";
</script>
