---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const path = stripLocale(stripBase(Astro.url.pathname), locale);
const links = [
  { label: "首页", route: "" },
  { label: "随笔", route: "posts" },
  { label: "摄影", route: "photography" },
  { label: "关于", route: "about" },
  ...(config.features.showArchives
    ? [{ label: "归档", route: "archives" }]
    : []),
  ...(config.features.search ? [{ label: "搜索", route: "search" }] : []),
];
---

<a class="skip-link" href="#main-content">跳转到正文</a>
<header class="site-header">
  <div class="wide-layout header-inner">
    <a class="site-brand" href={getRelativeLocaleUrl(locale, "")}
      ><span class="brand-mark" aria-hidden="true">知</span><span
        >{config.site.title}<small>记录 · 生活 · 探索</small></span
      ></a
    >
    <nav class="site-nav" id="site-nav" aria-label="主导航">
      {
        links.map(link => {
          const active = link.route
            ? path.startsWith("/" + link.route)
            : path === "/";
          return (
            <a
              href={getRelativeLocaleUrl(locale, link.route)}
              aria-current={active ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
    <div class="header-tools">
      {
        config.features.lightAndDarkMode && (
          <label class="theme-control">
            <>
              <span aria-hidden="true">◐</span>
              <select id="theme-select" aria-label="显示主题">
                <>
                  <option value="system">跟随系统</option>
                  <option value="light">浅色</option>
                  <option value="dark">深色</option>
                </>
              </select>
            </>
          </label>
        )
      }
      <button
        type="button"
        id="menu-btn"
        class="mobile-menu-button"
        aria-label="展开菜单"
        aria-expanded="false"
        aria-controls="site-nav"><span aria-hidden="true">☰</span></button
      >
    </div>
  </div>
</header>
<script>
  function initNavigation() {
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    const nav = document.querySelector<HTMLElement>("#site-nav");
    if (!button || !nav || button.dataset.bound) return;
    button.dataset.bound = "true";
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "收起菜单" : "展开菜单");
      nav.classList.toggle("is-open", open);
    };
    button.addEventListener("click", () =>
      setOpen(button.getAttribute("aria-expanded") !== "true")
    );
    nav.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setOpen(false);
        button.focus();
      }
    });
    nav
      .querySelectorAll("a")
      .forEach(link => link.addEventListener("click", () => setOpen(false)));
    document
      .querySelector<HTMLAnchorElement>(".skip-link")
      ?.addEventListener("click", () => {
        const main = document.getElementById("main-content");
        main?.setAttribute("tabindex", "-1");
        main?.focus();
        main?.addEventListener("blur", () => main.removeAttribute("tabindex"), {
          once: true,
        });
      });
  }
  initNavigation();
  document.addEventListener("astro:page-load", initNavigation);
</script>
