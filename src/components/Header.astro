---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { localize } from "@/i18n/site";
import config from "@/config";
import Xiaohei from "./Xiaohei.astro";
const locale = Astro.currentLocale ?? config.site.lang;
const s = localize(locale);
const path = stripLocale(stripBase(Astro.url.pathname), locale);
const links = [
  { label: "首页", route: "" },
  { label: "随笔", route: "posts" },
  { label: "摄影", route: "photography" },
  { label: "关于", route: "about" },
  ...(config.features.showArchives
    ? [{ label: "归档", route: "archives" }]
    : []),
  ...(config.features.search ? [{ label: "搜索", route: "search" }] : []),
];
---

<a class="skip-link" href="#main-content">{s("跳转到正文")}</a>
<header class="site-header" data-site-header>
  <div class="wide-layout header-inner">
    <a class="site-brand" href={getRelativeLocaleUrl(locale, "")}>
      <span class="brand-mark" aria-hidden="true">知</span>
      <span>{s(config.site.title)}<small>{s("记录 · 生活 · 探索")}</small></span
      >
    </a>
    <nav class="site-nav" id="site-nav" aria-label={s("主导航")}>
      {
        links.map(link => (
          <a
            href={getRelativeLocaleUrl(locale, link.route)}
            aria-current={
              (link.route ? path.startsWith("/" + link.route) : path === "/")
                ? "page"
                : undefined
            }
          >
            {s(link.label)}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <details class="language-picker" data-language-picker>
        <summary aria-label={s("选择语言")}
          ><span aria-hidden="true">◎</span>
          <span>{locale === "en" ? "EN" : "中"}</span><span
            class="control-caret"
            aria-hidden="true">⌄</span
          ></summary
        >
        <div class="language-options">
          {
            [
              { lang: "zh-CN", label: "中文" },
              { lang: "en", label: "English" },
            ].map(item => (
              <a
                href={
                  path.startsWith("/404")
                    ? item.lang === "en"
                      ? getRelativeLocaleUrl("en", "404")
                      : "/404.html"
                    : getRelativeLocaleUrl(item.lang, path.replace(/^\/+/, ""))
                }
                lang={item.lang}
                hreflang={item.lang}
                data-language-switch
                aria-current={locale === item.lang ? "true" : undefined}
              >
                {item.label}
                <span aria-hidden="true">
                  {locale === item.lang ? "✓" : ""}
                </span>
              </a>
            ))
          }
        </div>
      </details>
      {
        config.features.lightAndDarkMode && (
          <label class="theme-control">
            <>
              <span aria-hidden="true">◐</span>
              <select id="theme-select" aria-label={s("显示主题")}>
                <>
                  <option value="system">{s("跟随系统")}</option>
                  <option value="light">{s("浅色")}</option>
                  <option value="dark">{s("深色")}</option>
                </>
              </select>
            </>
          </label>
        )
      }
      <button
        type="button"
        id="menu-btn"
        class="mobile-menu-button"
        aria-label={s("展开菜单")}
        aria-expanded="false"
        aria-controls="site-nav"><span aria-hidden="true">☰</span></button
      >
    </div>
    <div class="header-rail" data-xiaohei-rail><Xiaohei mode="header" /></div>
  </div>
</header>
<script>
  import "@/scripts/navigation";
</script>
