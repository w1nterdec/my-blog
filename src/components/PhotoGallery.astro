---
import { localize } from "@/i18n/site";
const s = localize(Astro.currentLocale);
import { photos, personal } from "@/data/personal";
import { getAssetPath } from "@/utils/withBase";
---

<section class="photo-gallery" aria-label={s("摄影作品")}>
  {
    photos.length ? (
      <>
        <div class="gallery-filters" role="group" aria-label={s("摄影分类")}>
          {["全部", "人像", "猫犬", "风光"].map((label, i) => (
            <button
              type="button"
              data-photo-filter={label}
              aria-pressed={i === 0}
            >
              {s(label)}
            </button>
          ))}
        </div>
        <div class="photo-grid">
          {photos.map((photo, index) => (
            <button
              type="button"
              class="photo-work reveal"
              data-photo-index={index}
              data-category={photo.category}
              data-photo-src={getAssetPath(photo.src)}
              data-photo-alt={photo.alt}
              data-photo-title={photo.title}
              data-photo-story={photo.story}
              data-photo-details={[photo.date, photo.location, photo.camera]
                .filter(Boolean)
                .join(" · ")}
              aria-label={`${s("查看照片")}: ${photo.title}`}
            >
              <img
                src={getAssetPath(photo.src)}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                width={photo.width}
                height={photo.height}
              />
              <span class="photo-caption">
                <strong>{photo.title}</strong>
                <span>{photo.location ?? s(photo.category)}</span>
              </span>
            </button>
          ))}
        </div>
        <dialog class="photo-dialog" aria-label={s("照片预览")}>
          <div class="photo-dialog-controls">
            <>
              <span data-photo-counter />
              <button
                type="button"
                data-photo-close
                aria-label={s("关闭照片预览")}
              >
                {s("关闭 ×")}
              </button>
            </>
          </div>
          <div class="photo-viewer">
            <>
              <button
                type="button"
                data-photo-prev
                aria-label={s("上一张照片")}
              >
                ←
              </button>
              <img data-photo-large alt="" />
              <button
                type="button"
                data-photo-next
                aria-label={s("下一张照片")}
              >
                →
              </button>
            </>
          </div>
          <p data-photo-description />
        </dialog>
      </>
    ) : (
      <div class="gallery-waiting reveal">
        <div class="temporary-cover">
          <>
            <img
              src={getAssetPath(personal.avatar)}
              alt={s("临时封面：w1nter 的 GitHub 头像")}
              width="460"
              height="460"
            />
            <span>{s("临时封面 / GitHub 头像")}</span>
          </>
        </div>
        <div class="gallery-intro">
          <>
            <span class="eyebrow">{s("光影慢慢收集")}</span>
            <h2>{s("看见，也留下。")}</h2>
            <p>
              {s(
                "一些人像，一些偶遇的猫狗，还有家里的猫。真实作品正在整理，先为它们留一个安静的位置。"
              )}
            </p>
            <div class="photo-categories">
              <>
                <div>
                  <>
                    <span>01 / PORTRAITS</span>
                    <h3>{s("人像")}</h3>
                    <p>{s("留住人与光相遇的瞬间。")}</p>
                  </>
                </div>
                <div>
                  <>
                    <span>02 / CATS & DOGS</span>
                    <h3>{s("猫犬")}</h3>
                    <p>{s("偶遇的毛茸茸，和家里的猫。")}</p>
                  </>
                </div>
              </>
            </div>
          </>
        </div>
      </div>
    )
  }
</section>
<script>
  import { initGallery } from "@/scripts/gallery";
  initGallery();
  document.addEventListener("astro:page-load", initGallery);
</script>
