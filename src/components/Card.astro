---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, pubDatetime, modDatetime } = data;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const modified = modDatetime && modDatetime > pubDatetime;
const datetime = modified ? modDatetime : pubDatetime;
const date = new Intl.DateTimeFormat(locale, {
  dateStyle: "long",
  timeZone: data.timezone ?? config.site.timezone,
}).format(datetime);
---

<li class="post-entry">
  <Heading transition:name={toTransitionName(id)}>
    <a href={getPostUrl(id, filePath, locale)}>{title}</a>
  </Heading>
  <p>{description}</p>
  <div class="post-meta">
    <time datetime={datetime.toISOString()}
      >{modified ? `${t.post.updatedAt} · ` : ""}{date}</time
    >
    {
      tags.map(tag => (
        <>
          <span aria-hidden="true">·</span>
          <a href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}`)}>
            #{tag}
          </a>
        </>
      ))
    }
  </div>
</li>
