---
import { localize } from "@/i18n/site";
const s = localize(Astro.currentLocale);
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PhotoGallery from "@/components/PhotoGallery.astro";
---

<Layout
  title={s("映 · 摄影集 | 知行博客")}
  description={s("w1nter 的摄影集：人像、偶遇的猫犬与生活中的光影。")}
>
  <Header />
  <main id="main-content" class="wide-layout photography-page">
    <header class="page-heading reveal">
      <span class="eyebrow">{s("PHOTOGRAPHY / 光影之间")}</span><h1
        class="display-title"
      >
        映<span class="title-dot">.</span>
      </h1><p>{s("把转瞬即逝，留成可以回望的片刻。")}</p>
    </header>
    <PhotoGallery />
  </main>
  <Footer />
</Layout>
