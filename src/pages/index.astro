---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyAll } from "@/utils/slugify";
import { localize } from "@/i18n/site";
import { personal } from "@/data/personal";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const s = localize(locale);
const posts = getSortedPosts(await getCollection("posts"));
const recent = posts.slice(0, config.posts.perIndex);
const tags = getUniqueTags(posts).map(tag => ({
  ...tag,
  count: posts.filter(post => slugifyAll(post.data.tags).includes(tag.tag))
    .length,
}));
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="wide-layout home-page"
    data-home-path={homePath}
  >
    <section class="home-intro" aria-labelledby="intro-title">
      <h1 id="intro-title">
        {s("我是")}{" "}
        <span class="sr-only">{personal.name}</span>
        <span
          class="intro-typewriter"
          data-typewriter={personal.name}
          aria-hidden="true"
        >
          <span class="intro-typewriter-sizer">{personal.name}</span>
          <span class="intro-typewriter-text" data-typewriter-output
            >{personal.name}</span
          >
        </span>
      </h1>
    </section>
    <section class="writing-section" aria-labelledby="writing-title">
      <header class="writing-heading">
        <p>{s("我写的文章")}</p>
        <h2 id="writing-title">{s("文章")}</h2>
      </header>
      {
        tags.length > 0 && (
          <nav class="writing-tags" aria-label={s("按标签浏览文章")}>
            <span>{s("标签：")}</span>
            {tags.map(tag => (
              <a href={getRelativeLocaleUrl(locale, `tags/${tag.tag}`)}>
                #{tag.tagName} <span>({tag.count})</span>
              </a>
            ))}
          </nav>
        )
      }
      {
        posts.length ? (
          <ul class="post-list">
            {recent.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <div class="writing-empty">
            <p>{s("还没有发表文章。")}</p>
          </div>
        )
      }
      <a
        class="text-link all-posts-link"
        href={getRelativeLocaleUrl(locale, "posts")}
        >{s("查看所有文章")} <span aria-hidden="true">→</span></a
      >
    </section>
  </main>
  <Footer />
</Layout>
<script>
  import { initTypewriters } from "@/scripts/typewriter";
  initTypewriters();
  document.addEventListener("astro:page-load", initTypewriters);
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("[data-home-path]");
    if (!main) return;
    try {
      sessionStorage.setItem("backUrl", main.dataset.homePath ?? "/");
    } catch {
      /* Storage is optional. */
    }
  });
</script>
