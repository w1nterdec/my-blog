---
import { localize } from "@/i18n/site";
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TravelGlobe from "@/components/TravelGlobe.astro";
import AboutOutline from "@/components/AboutOutline.astro";
import { personal, places } from "@/data/personal";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
const s = localize(Astro.currentLocale);
const about = await getEntry(
  "pages",
  Astro.currentLocale === "en" ? "about-en" : "about"
);
if (!about) throw new Error("Missing about content");
const { Content, headings } = await render(about);
const outline = headings
  .filter(heading => heading.depth === 2)
  .slice(0, 2)
  .map(({ slug, text }) => ({ slug, text }));
if (places.length > 0) outline.push({ slug: "footprints", text: s("足迹") });
const credits = await getEntry(
  "pages",
  Astro.currentLocale === "en" ? "credits-en" : "credits"
);
if (!credits) throw new Error("Missing site credits");
const { Content: Credits } = await render(credits);
---

<Layout
  title={about.data.title + " | " + s(config.site.title)}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />
  <AboutOutline entries={outline} />
  <main id="main-content" class="wide-layout about-page">
    <section class="about-hero">
      <div class="about-identity">
        <img
          src={getAssetPath(personal.avatar)}
          width="80"
          height="80"
          alt={personal.name}
        />
        <div>
          <h1>{personal.name}</h1>
          <p class="signature">{personal.signature}</p>
        </div>
      </div>
    </section>
    <section class="about-copy app-prose" aria-label={s("个人介绍")}>
      <Content />
    </section>
    {places.length > 0 && <TravelGlobe />}
    <section class="about-credits app-prose" aria-label={s("网站致谢")}>
      <Credits />
    </section>
  </main>
  <Footer />
</Layout>
